# Virtual environment
venv/

# Python cache
__pycache__/
*.pyc

# Dataset - too large for git, and reproducible via kaggle download command in README
data/

# Generated embeddings/FAISS index - large binaries, regenerate via scripts/
embeddings/
*.npy
*.npz
*.faiss
*.index

# Cached model predictions written by src/calibration.py (get_probs). Pure
# derived data: ~250 KB per split, regenerated by re-running the script, and
# stale the moment the .tflite changes. Delete the dir to force re-inference.
outputs/cache/

# Kaggle credentials - should never be committed
kaggle.json

# OS/editor junk
.vscode/
.idea/
Thumbs.db
.DS_Store

# Jupyter
.ipynb_checkpoints/